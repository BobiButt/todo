# ============================================================================
# FILE:       frontend/.env.example
# PURPOSE:    Safe template for frontend Vite configuration.
# Copy to .env and fill in real values. Never commit .env — only this example file.
# Note: Vercel only exposes VITE_* variables to the browser at build time. We
# inject API_BASE_URL via vite.config.ts define, so set API_BASE_URL in the
# Vercel Project Settings → Environment Variables (not VITE_*).
# ============================================================================

# Backend API base URL.
# Local development (points to your running backend):
API_BASE_URL=http://localhost:8000/api/v1

# Production on Vercel: set API_BASE_URL in Project Settings → Environment Variables
# to your deployed backend URL, e.g. https://taskflow-backend.vercel.app/api/v1
# Leave blank to use relative /api/v1 (same origin proxy).
