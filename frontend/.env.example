# ============================================================================
# FILE:       frontend/.env.example
# PURPOSE:    Safe template for frontend Vite configuration.
# Copy to .env and fill in real values. Only VITE_* variables are exposed
# to the browser. Never commit .env — only this example file.
# ============================================================================

# Backend API base URL. In production on Vercel this is the same origin
# (Vercel routes /api/* to the backend serverless function), so you can leave
# it empty or set it to your deployed backend URL.
VITE_API_BASE_URL=
