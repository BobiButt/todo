# ============================================================================
# FILE:       backend/.env.example
# PURPOSE:    Safe, committed template of the local environment configuration.
#             Copy it to `backend/.env` (git-ignored) and adjust the values.
# HOW IT WORKS: Each line is `KEY=VALUE`. pydantic-settings reads this file on
#             startup and maps the keys onto the typed fields of
#             app/config.py (unknown keys are ignored).
# USED BY / DEPENDS ON: consumed by app/config.py; documented in
#             docs/CONFIG_EXPLAINED.md section 2.
# KEY CONCEPTS: environment variables, secrets hygiene (never commit .env),
#             JSON-encoded list value for CORS_ORIGINS.
# ============================================================================

# ENVIRONMENT switches app behaviour: "development" enables Swagger UI at /docs
# and verbose error details; "production" hides them.
ENVIRONMENT=development

# DATABASE_URL is the single connection string SQLAlchemy parses to reach
# PostgreSQL. Format: <dialect>+<driver>://user:password@host:port/dbname
# NOTE: change the password to match what you set in POSTGRES_SETUP.md §5.2.
DATABASE_URL=postgresql+asyncpg://taskflow_user:CHANGE_ME_strong_password@localhost:5432/taskflow

# Tests use this separate database and truncate it between cases.
TEST_DATABASE_URL=postgresql+asyncpg://taskflow_user:CHANGE_ME_strong_password@localhost:5432/taskflow_test

# CORS_ORIGINS is a JSON list of browser origins allowed to call the API.
# Vite's dev server runs on 5173 — without this entry the browser would block
# every fetch with a CORS error.
CORS_ORIGINS=["http://localhost:5173"]

# APP_PREFIX puts every API route under /api/v1 so a future v2 can coexist.
APP_PREFIX=/api/v1

# MAX_IMPORT_BYTES caps uploaded import files at 2 MB (FastAPI returns 413
# above it) — a deliberate denial-of-service guard.
MAX_IMPORT_BYTES=2097152

# AI providers are optional. The backend selects the first configured key in
# this order: OpenRouter, Gemini, then Groq. Never put these keys in frontend/.env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
