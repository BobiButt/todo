	CREATE TABLE users (
		id INTEGER GENERATED ALWAYS AS IDENTITY, 
		email VARCHAR(255) NOT NULL, 
		name VARCHAR(80) NOT NULL, 
		role VARCHAR(10) DEFAULT 'user' NOT NULL, 
		created_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
